# Copia este archivo a `.env` (que está en .gitignore) y cambia los valores.
# No subas `.env` al repositorio.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arbol_venta_auth
DB_USERNAME=postgres
DB_PASSWORD=cambia_esto

# JWT: mínimo 32 bytes. En producción usa un secreto largo y aleatorio.
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_bytes
JWT_EXPIRATION_SECONDS=86400

# CORS: orígenes del frontend separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Tenant demo creado por V2__seed_dev.sql
DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111111
